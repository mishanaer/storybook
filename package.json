{
  "name": "@mishanaer/storybook-shell",
  "version": "1.1.0",
  "description": "A custom Storybook manager shell powered by the original Storybook runtime",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "preset.js",
    "README.md",
    "LICENSE"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./styles.css": "./src/storybook-shell.css",
    "./preset": "./preset.js",
    "./manager": "./src/storybook/manager.jsx",
    "./adapter": "./src/storybook/adapter.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18",
    "storybook": ">=10.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  }
}
