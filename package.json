{
  "name": "@mishanaer/butcher",
  "version": "2.0.0",
  "description": "Custom Storybook manager shell with deslop primitives and Mini App UI",
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@4.5.3",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "bin",
    "src",
    "preset.js",
    "mini-app/components",
    "mini-app/hooks",
    "mini-app/lib",
    "mini-app/styles",
    "mini-app/theme",
    "mini-app/utils",
    "mini-app/MiniAppProvider.js",
    "mini-app/index.js",
    "primitives",
    "README.md",
    "LICENSE"
  ],
  "bin": "./bin/butcher.mjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./config": {
      "types": "./src/config.d.ts",
      "import": "./src/config.js"
    },
    "./preset": "./preset.js",
    "./preview": "./src/preview.js",
    "./manager": "./src/storybook/manager.jsx",
    "./adapter": "./src/storybook/adapter.js",
    "./shell": "./src/StorybookShell.jsx",
    "./mini-app": "./mini-app/index.js",
    "./mini-app/*": "./mini-app/*",
    "./primitives": "./primitives/index.js",
    "./primitives/*": "./primitives/*",
    "./styles.css": "./src/storybook-shell.css"
  },
  "scripts": {
    "dev": "node ./bin/butcher.mjs dev -c mini-app/storybook/.storybook -p 6006",
    "build": "node ./bin/butcher.mjs build -c mini-app/storybook/.storybook -o mini-app/storybook/storybook-static",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/verify-integration.mjs",
    "verify:source": "yarn --cwd mini-app/storybook verify",
    "verify": "yarn test && yarn test:integration && yarn verify:source && npm pack --dry-run --cache .cache/npm"
  },
  "dependencies": {
    "@lisse/core": "0.5.2",
    "@lisse/react": "^0.5.2",
    "@storybook/react-vite": "10.5.5",
    "@tanstack/react-virtual": "^3.14.6",
    "calligraph": "^1.4.1",
    "clsx": "^2.1.1",
    "colorthief": "^3.4.0",
    "markdown-to-jsx": "9",
    "motion": "^12.42.2",
    "prop-types": "^15.8.1",
    "storybook": "10.5.5",
    "vite": "7",
    "wouter": "^3.10.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3"
  }
}
