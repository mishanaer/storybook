{
  "title": "Product UI",
  "scope": {
    "id": "product-ui",
    "environment": "web-development"
  },
  "preview": {
    "adapter": "react-vite",
    "isolation": "iframe",
    "entry": "src/showcase/preview-entry.tsx"
  },
  "groups": [
    {
      "id": "foundations",
      "title": "Foundations",
      "items": [
        {
          "id": "colors",
          "title": "Colors",
          "source": "src/showcase/foundations/Colors.showcase.tsx",
          "kind": "foundation"
        }
      ]
    },
    {
      "id": "components",
      "title": "Components",
      "items": [
        {
          "id": "button",
          "title": "Button",
          "source": "src/components/Button/Button.showcase.tsx",
          "productionRoot": "src/components/Button/Button.tsx",
          "kind": "primitive",
          "states": ["default", "disabled", "pressed"],
          "boundaries": []
        },
        {
          "id": "message-composer",
          "title": "Message Composer",
          "source": "src/components/MessageComposer/MessageComposer.showcase.tsx",
          "productionRoot": "src/screens/Conversation/ConversationScreen.tsx",
          "kind": "product",
          "states": ["empty", "draft", "sending", "error"],
          "boundaries": ["http", "local-storage", "time"]
        }
      ]
    }
  ],
  "exclusions": []
}
